# Copy to .env for local pipeline runs (GitHub Actions uses repo secrets instead — see README).
# NEVER commit .env.

# GitHub fine-grained PAT, public-repo read-only (5,000 req/hr)
GITHUB_TOKEN=github_pat_...

# Supabase Postgres DSN — the ONLY DB credential the pipeline uses (psycopg).
# Project Settings → Database → Connection string → URI (Session pooler, port 5432).
# Replace [YOUR-PASSWORD] with the DB password you set at project creation.
DATABASE_URL=postgresql://postgres.YOURPROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API. These are for the WEB app's triage-write route
# (service role, server-side) — NOT the pipeline. The service-role key is a PostgREST
# JWT, not a DB password; the pipeline connects with DATABASE_URL above.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # web triage route only; never ships to the browser

# Web app (Vercel env vars; anon key is safe to expose — RLS is read-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EDIT_SECRET=choose-a-team-edit-key        # gates triage writes via /api/triage

# CI classifier auth (repo secret only — from `claude setup-token`, valid ~1 year)
# CLAUDE_CODE_OAUTH_TOKEN=...
# Escape hatch if subscription limits ever bind (config: classifier.api_fallback):
# ANTHROPIC_API_KEY=...
