# Copy to .env for local pipeline runs (GitHub Actions uses repo secrets instead — see README).
# NEVER commit .env.

# GitHub fine-grained PAT, public-repo read-only (5,000 req/hr)
GITHUB_TOKEN=github_pat_...

# Supabase → Project Settings → API
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server-side only; never ships to the browser

# Web app (Vercel env vars; anon key is safe to expose — RLS is read-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EDIT_SECRET=choose-a-team-edit-key        # gates triage writes via /api/triage

# CI classifier auth (repo secret only — from `claude setup-token`, valid ~1 year)
# CLAUDE_CODE_OAUTH_TOKEN=...
# Escape hatch if subscription limits ever bind (config: classifier.api_fallback):
# ANTHROPIC_API_KEY=...
